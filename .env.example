# Copy this file to .env and fill in the values. Never commit .env.
# Credentials: Lumen Organization Portal -> Settings -> API Keys
LUMEN_API_KEY=
LUMEN_API_SECRET=
# Base URLs from the "servers" section of ocr-openapi.yaml and ai-chat-openapi.yaml
LUMEN_OCR_URL=
LUMEN_CHAT_URL=
# Optional: a specific AI Chat instance ID. If blank, the first ACTIVE instance is used.
LUMEN_CHAT_INSTANCE_ID=
